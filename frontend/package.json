{
  "name": "ai-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:local": "cp next.config.dev.js next.config.js && next dev --port 3000",
    "build": "cp next.config.prod.js next.config.js && mv src/app/api src/app/api.bak 2>/dev/null || true && next build && mv src/app/api.bak src/app/api 2>/dev/null || true",
    "build:prod": "cp next.config.prod.js next.config.js && mv src/app/api src/app/api.bak 2>/dev/null || true && next build && mv src/app/api.bak src/app/api 2>/dev/null || true",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.0.4",
    "react": "^18",
    "react-dom": "^18",
    "ai": "^3.0.9",
    "@aws-amplify/ui-react": "^6.1.0",
    "aws-amplify": "^6.0.0",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "swr": "^2.2.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0"
  }
}