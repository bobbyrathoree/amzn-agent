    "destroy:prod": "cdk destroy --all --context env=prod",
    "diff": "cdk diff --context env=dev"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "18.15.11",
    "aws-cdk": "^2.77.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.0.4"
  },
  "dependencies": {
    "@cdklabs/generative-ai-cdk-constructs": "0.1.309",
    "aws-cdk-lib": "^2.77.0",
    "constructs": "^10.2.0",
    "source-map-support": "^0.5.21"
  }
}
